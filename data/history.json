      "content": "\n\nملف: index.html\n<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Kashida Pro</title>\n    <link rel=\"icon\" type=\"image/png\" href=\"icons/plugin-icon@1x.png\">\n    <link rel=\"stylesheet\" href=\"css/styles.css\">\n</head>\n<body class=\"rtl\" dir=\"rtl\">\n    <div id=\"app\">\n        <!-- Header -->\n        <div class=\"header\">\n            <div class=\"title-group\">\n                <h1 class=\"title\">Kashida Pro</h1>\n                <p class=\"subtitle\" id=\"subtitle\">تسوية احترافية للنصوص العربية</p>\n            </div>\n            <button id=\"lang-toggle\" class=\"lang-btn\">English</button>\n        </div>\n\n        <!-- Settings Panel -->\n        <div class=\"settings-panel\">\n            <div class=\"setting-group\">\n                <label class=\"setting-label\" id=\"intensity-label\">الكثافة</label>\n                <div class=\"slider-group\">\n                    <input type=\"range\" id=\"intensity-slider\" min=\"0\" max=\"300\" value=\"100\" class=\"slider\">\n                    <span id=\"intensity-value\" class=\"value-display\">100%</span>\n                </div>\n            </div>\n\n            <div class=\"setting-group\">\n                <label class=\"setting-label\" id=\"max-label\">أقصى كشيدة لكل كلمة</label>\n                <div class=\"slider-group\">\n                    <input type=\"range\" id=\"max-slider\" min=\"1\" max=\"15\" value=\"1\" class=\"slider\">\n                    <span id=\"max-value\" class=\"value-display\">1</span>\n                </div>\n            </div>\n\n            <div class=\"setting-group\">\n                <label class=\"setting-label\" id=\"words-per-line-label\">كلمات في كل سطر (0 = تلقائي)</label>\n                <div class=\"slider-group\">\n                    <input type=\"range\" id=\"words-per-line-slider\" min=\"0\" max=\"15\" value=\"0\" class=\"slider\">\n                    <span id=\"words-per-line-value\" class=\"value-display\">تلقائي</span>\n                    <button id=\"reflow-btn\" class=\"btn-reflow\" title=\"Apply reflow only\">\n                        <span id=\"reflow-text\">↻</span>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Skip Words Feature -->\n            <div class=\"setting-group skip-section\">\n                <div class=\"skip-header\">\n                    <label class=\"setting-label\" id=\"skip-label\">تخطي الكلمات</label>\n                    <label class=\"toggle-switch\">\n                        <input type=\"checkbox\" id=\"skip-enabled\" class=\"toggle-input\">\n                        <span class=\"toggle-slider\"></span>\n                    </label>\n                </div>\n                <div id=\"skip-controls\" class=\"skip-controls\">\n                    <div class=\"skip-option\">\n                        <label class=\"skip-option-label\" id=\"skip-first-label\">تخطي أول كلمات</label>\n                        <div class=\"slider-group\">\n                            <input type=\"range\" id=\"skip-first-slider\" min=\"0\" max=\"10\" value=\"0\" class=\"slider\">\n                            <span id=\"skip-first-value\" class=\"value-display\">0</span>\n                        </div>\n                    </div>\n                    <div class=\"skip-option\">\n                        <label class=\"skip-option-label\" id=\"skip-line-words-label\">تخطي السطور بـ ≤ كلمات (0 = تعطيل)</label>\n                        <div class=\"slider-group\">\n                            <input type=\"range\" id=\"skip-line-words-slider\" min=\"0\" max=\"10\" value=\"0\" class=\"slider\">\n                            <span id=\"skip-line-words-value\" class=\"value-display\">0</span>\n                        </div>\n                    </div>\n                    <div class=\"checkbox-group\">\n                        <input type=\"checkbox\" id=\"skip-last-line\" class=\"checkbox\">\n                        <label for=\"skip-last-line\" class=\"checkbox-label\" id=\"skip-last-line-label\">\n                            تخطي السطر الأخير\n                        </label>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Kurdish Mode Toggle -->\n            <div class=\"setting-group\">\n                <div class=\"skip-header\">\n                    <label class=\"setting-label\" id=\"kurdish-mode-label\">وضع كوردی</label>\n                    <label class=\"toggle-switch\">\n                        <input type=\"checkbox\" id=\"kurdish-mode-enabled\" class=\"toggle-input\">\n                        <span class=\"toggle-slider\"></span>\n                    </label>\n                </div>\n            </div>\n\n            <!-- Advanced Rules (Read-only) -->\n            <div class=\"setting-group rules-button-group\">\n                <button id=\"rules-toggle-btn\" class=\"btn-rules-preview\">\n                    <span id=\"rules-toggle-text\">معاينة القواعد</span>\n                </button>\n            </div>\n            <div class=\"rules-section\" id=\"rules-section\" style=\"display: none;\">\n                <h3 class=\"rules-title\" id=\"rules-title\">القواعد المطبقة</h3>\n                <ul class=\"rules-list\">\n                    <li id=\"rule1\">• لا كشيدة في الكلمات القصيرة (أقل من 3 حروف)</li>\n                    <li id=\"rule2\">• لا كشيدة بعد الحروف المنفصلة (د، ذ، ر، ز، و، ا)</li>\n                    <li id=\"rule3\">• لا كشيدة في بداية الكلمة</li>\n                    <li id=\"rule4\">• لا كشيدة بعد الكاف (ك)</li>\n                    <li id=\"rule5\">• لا كشيدة قبل أو بعد اللام (ل) مطلقاً او اللجامات (لا، لأ، لإ، لآ)</li>\n                    <li id=\"rule6\">• لا كشيدة قبل الياء الأخيرة (ي)</li>\n                    <li id=\"rule7\">• لا كشيدة قبل التاء المربوطة (ة)</li>\n                    <li id=\"rule8\">• لا كشيدة في منطقة أل التعريف</li>\n                    <li id=\"rule9\">• تفضيل الكشيدة بعد السين والصاد (س، ش، ص، ض)</li>\n                    <li id=\"rule10\">• لا كشيدة في كلمات محددة (على، إلى، من، إلخ)</li>\n                    <li id=\"rule11\">• تجاهل التشكيل عند تطبيق الكشيدة بين الحروف</li>\n                </ul>\n            </div>\n\n            <!-- Status -->\n            <div id=\"status\" class=\"status\"></div>\n        </div>\n\n        <!-- Fixed Bottom Panel -->\n        <div class=\"bottom-panel\">\n            <div class=\"button-row\">\n                <button id=\"reset-btn\" class=\"btn btn-secondary\">\n                    <span id=\"reset-text\">إعادة تعيين</span>\n                </button>\n            </div>\n            \n            <div class=\"button-row tashkeel-buttons\">\n                <button id=\"remove-tashkeel-btn\" class=\"btn btn-tertiary\">\n                    <span id=\"remove-tashkeel-text\">إزالة التشكيل</span>\n                </button>\n                <button id=\"restore-tashkeel-btn\" class=\"btn btn-tertiary\">\n                    <span id=\"restore-tashkeel-text\">إعادة التشكيل</span>\n                </button>\n                <button id=\"restore-selected-btn\" class=\"btn btn-tertiary\">\n                    <span id=\"restore-selected-text\">استعادة المحدد</span>\n                </button>\n            </div>\n            \n            <div class=\"button-row\">\n                <button id=\"remove-btn\" class=\"btn btn-danger\">\n                    <span id=\"remove-text\">إزالة الكشيدة</span>\n                </button>\n                <button id=\"apply-btn\" class=\"btn btn-primary\">\n                    <span id=\"apply-text\">تطبيق الكشيدة</span>\n                </button>\n            </div>\n        </div>\n\n        <!-- Note Button (Glowing) -->\n        <div class=\"note-button-container\">\n            <button id=\"note-btn\" class=\"btn-note\">\n                <span id=\"note-text\">💡 ملاحظة</span>\n            </button>\n        </div>\n\n        <!-- Credit Footer -->\n        <div class=\"credit-footer\">\n            <span id=\"created-by\">إنشاء</span> <a href=\"#\" id=\"credit-link\">عثمان أحمد</a>\n        </div>\n    </div>\n\n    <!-- Support Modal -->\n    <div id=\"support-modal\" class=\"modal-overlay\">\n        <div class=\"modal-content\">\n            <button id=\"modal-close\" class=\"modal-close\">&times;</button>\n            <div class=\"modal-body\">\n                <div class=\"modal-icon\">💡</div>\n                <h3 id=\"modal-title\" class=\"modal-title\">ملاحظة</h3>\n                <p id=\"modal-message\" class=\"modal-message\">\n                    هذه الأداة مجانية بالكامل.<br><br>\n                    إذا رغبت بدعمي للاستمرار في تطوير أدوات مفيدة للمجتمع العربي والعالمي، فإن تشجيعك يصنع فرقًا كبيرًا 💛\n                </p>\n                <button id=\"support-btn\" class=\"btn-support\">\n                    <span id=\"support-text\">💛 ادعمني</span>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Scripts -->\n    <script src=\"js/CSInterface.min.js\"></script>\n    <script src=\"js/main.js\"></script>\n</body>\n</html>\n"
